# Install as /etc/thelastgameofmoyn/visualApp.env and verify on Pi B.
# PROJECTOR_OUTPUT is the XRandR connector name. PROJECTOR_KMS_CONNECTOR is
# the kernel/KMS name used in /boot/firmware/cmdline.txt.
DISPLAY=:0
XAUTHORITY=/home/kathapult/.Xauthority
OSC_EXPECTED_SOURCE_IP=10.0.0.1
PREVIEW_TIMEOUT_SECONDS=1.0
PROJECTOR_OUTPUT=HDMI-1
PROJECTOR_KMS_CONNECTOR=HDMI-A-1
# Native mode of the installed projector. visualApp performs the calibrated
# content rotation itself; XRandR deliberately stays at normal orientation.
PROJECTOR_MODE=1024x768
PROJECTOR_RATE=60

# Disable every other XRandR output before visualApp starts. This makes the
# configured projector the sole primary display, so OF_FULLSCREEN cannot land
# on an accidentally attached maintenance monitor.
PROJECTOR_EXCLUSIVE=1
