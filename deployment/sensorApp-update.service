# Installieren auf Pi A nach /etc/systemd/system/sensorApp-update.service.
# Läuft einmal durch und beendet sich danach wieder - ausgelöst von
# sensorApp-update.timer, nicht direkt gestartet.

[Unit]
Description=Prüft sensorApp auf Git-Updates
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root

# Das kurzlebige privilegierte Orchestratorskript führt Git und Build explizit
# als kathapult aus. Es verwendet Root für Release-/Zustandspfade,
# Unit-Installation und systemctl und endet nach diesem Update-Lauf.
ExecStart=/usr/local/sbin/thelastgameofmoyn-update-app sensorApp
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sensorApp-update
